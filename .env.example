# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 .gitignore 대상이라 커밋되지 않습니다)
#   macOS/Linux: cp .env.example .env
#   Windows    : Copy-Item .env.example .env

# 필수: API Key
AI_API_KEY=

# 선택: Anthropic 호환 프록시를 쓸 때만 (기본 https://api.anthropic.com, 끝에 /v1 은 붙이지 않음)
# AI_API_BASE_URL=https://api.anthropic.com

# 선택: 기본 모델 변경 (사용하는 서버가 지원하는 모델명)
# AI_MODEL=claude-sonnet-5-5
